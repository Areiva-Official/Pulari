# ─── Production environment overrides ────────────────────────────────────────
# Vite merges this file on top of .env when running `vite build`.
# These values CANNOT be overridden at runtime — they are compiled into the bundle.

# Always use Cognito in production builds — PIN fallback is never available.
VITE_APP_ENV=production
VITE_AUTH_MODE=cognito

# Pinpoint app ID (mirrors .env — must match the eu-west-1 project)
VITE_PINPOINT_APP_ID=5b6a43af7fa844a7bd13a84edc5deaeb

# ─── Live backend (API Gateway → Lambda → DynamoDB) ───────────────────────────
# Production talks to the real backend. Admin routes require a Cognito JWT
# from the `admins` group (enforced in-Lambda + at the API Gateway authorizer).
VITE_API_BASE_URL=https://b17vxcc00b.execute-api.eu-west-1.amazonaws.com

# ─── Stripe publishable key (fallback) ────────────────────────────────────────
# Preferred: set it in admin Settings (DynamoDB) so no rebuild is needed.
# This is only a fallback. The SECRET key lives in Lambda env, never here.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
